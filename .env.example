# Copy this file to .env and fill in real values. Never commit .env.
APPLICATION_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=5000

COMPANY_DOCUMENT_PATH=./data/raw/company.html
CHUNKS_PATH=./data/processed/chunks.json
CHROMA_PATH=./vector_db/chroma
CHROMA_COLLECTION=abc_company

EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
# --- LLM (Step 10) -------------------------------------------------------------
# LLM_PROVIDER: fake | anthropic | openai | openai-compatible | ollama
#   fake              canned answers, no key needed (offline testing only, NOT real answers)
#   anthropic         Claude        (needs LLM_API_KEY and LLM_MODEL)
#   openai            OpenAI        (needs LLM_API_KEY and LLM_MODEL)
#   ollama            local models  (needs LLM_MODEL, no key)
#   openai-compatible any server that speaks the OpenAI chat format (needs LLM_BASE_URL and LLM_MODEL)
LLM_PROVIDER=
LLM_MODEL=
# The key goes ONLY here, in your private .env file. Never commit it, never paste it into a chat.
LLM_API_KEY=
# Only for gateways or local servers, for example http://localhost:11434/v1 (Ollama). Leave empty otherwise.
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30
# LLM_TEMPERATURE: 0 = most predictable. Leave it EMPTY (LLM_TEMPERATURE=) for models that reject it.
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=600
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1.0

TOP_K=5
# Most characters of retrieved text placed into one prompt (about 3 characters per token of cost).
CONTEXT_MAX_CHARS=12000
# Minimum cosine similarity for a passage to count as evidence (provisional, see README Step 12). NOT 0.75 any more.
RELEVANCE_THRESHOLD=0.20
CHUNK_MAX_WORDS=150
CHUNK_OVERLAP_WORDS=20
